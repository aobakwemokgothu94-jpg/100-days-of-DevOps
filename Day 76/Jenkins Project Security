## 🛠️ CLI & REST/Groovy API Execution

All steps were executed purely from `jump-host` (`thor@jumphost`) over the Jenkins HTTP & Groovy Script Console APIs using CSRF crumb authentication.

### 1. Install `matrix-auth` Plugin & Safe Restart
```bash
JENKINS_URL="http://jenkins:8080"
AUTH='admin:Adm!n321'

# Obtain CSRF crumb and session cookie
CRUMB=$(curl -s -c /tmp/cookies.txt -u "$AUTH" \
  "$JENKINS_URL/crumbIssuer/api/xml?xpath=concat(//crumbRequestField,\":\",//crumb)")

# Install Matrix Authorization Strategy plugin
curl -s -b /tmp/cookies.txt -u "$AUTH" -H "$CRUMB" \
  -H "Content-Type: text/xml" \
  -d '<jenkins><install plugin="matrix-auth@latest" /></jenkins>' \
  "$JENKINS_URL/pluginManager/installNecessaryPlugins"

sleep 20

# Trigger Jenkins safe restart and wait for readiness
curl -s -X POST -b /tmp/cookies.txt -u "$AUTH" -H "$CRUMB" \
  "$JENKINS_URL/safeRestart"

sleep 15
until curl -s -u "$AUTH" -o /dev/null -w "%{http_code}" "$JENKINS_URL/api/json" | grep -q "200"; do
  sleep 3
done
```

### 2. Configure Global Matrix Strategy & `Packages` Job ACL
```groovy
// /tmp/configure_perms.groovy
import jenkins.model.*
import hudson.security.*
import hudson.model.*
import org.jenkinsci.plugins.matrixauth.inheritance.*

def instance = Jenkins.getInstance()

// 1. Enable Project-based Matrix Authorization Strategy globally
def strategy = new ProjectMatrixAuthorizationStrategy()
strategy.add(Jenkins.ADMINISTER, "admin")
strategy.add(Jenkins.READ, "sam")
strategy.add(Jenkins.READ, "rohan")
instance.setAuthorizationStrategy(strategy)
instance.save()

// 2. Scope permissions strictly to the "Packages" job
def job = instance.getItemByFullName("Packages", Job.class)
if (job == null) {
    throw new RuntimeException("Job 'Packages' not found!")
}

def existingProp = job.getProperty(AuthorizationMatrixProperty.class)
if (existingProp != null) {
    job.removeProperty(existingProp)
}

def jobProp = new AuthorizationMatrixProperty()
jobProp.setInheritanceStrategy(new InheritParentStrategy())

// sam: build, configure, read
jobProp.add(Item.BUILD, "sam")
jobProp.add(Item.CONFIGURE, "sam")
jobProp.add(Item.READ, "sam")

// rohan: build, cancel, configure, read, update, tag
jobProp.add(Item.BUILD, "rohan")
jobProp.add(Item.CANCEL, "rohan")
jobProp.add(Item.CONFIGURE, "rohan")
jobProp.add(Item.READ, "rohan")

def updatePerm = Permission.getAll().find { it.id == "hudson.model.Run.Update" }
def tagPerm = Permission.getAll().find { it.id == "hudson.scm.SCM.Tag" }

if (updatePerm != null) jobProp.add(updatePerm, "rohan")
if (tagPerm != null) jobProp.add(tagPerm, "rohan")

job.addProperty(jobProp)
job.save()
```

### 3. Execute Configuration Script via API
```bash
CRUMB=$(curl -s -c /tmp/cookies.txt -u "$AUTH" \
  "$JENKINS_URL/crumbIssuer/api/xml?xpath=concat(//crumbRequestField,\":\",//crumb)")

curl -s -b /tmp/cookies.txt -u "$AUTH" -H "$CRUMB" \
  --data-urlencode "script@/tmp/configure_perms.groovy" \
  "$JENKINS_URL/scriptText"
```

